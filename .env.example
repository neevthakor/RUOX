# RUOX Environment Configuration
# LOCAL_ONLY mode blocks all external network requests
LOCAL_ONLY=true

# Provider Settings
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local LLM Config (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
FAST_LOCAL_MODEL=qwen2.5:0.5b
DEFAULT_LOCAL_MODEL=qwen2.5:7b
STRONG_LOCAL_MODEL=qwen2.5:14b

# Voice Configuration
VOICE_ENABLED=true
VOICE_MAX_RECORD_SECONDS=30
VOICE_MIN_RECORD_SECONDS=1
VOICE_SILENCE_THRESHOLD=0.01
STT_MODEL=tiny.en
STT_DEVICE=cpu
TTS_RATE=150
TTS_VOLUME=1.0

# Computer Control Configuration
COMPUTER_CONTROL_ENABLED=true
COMPUTER_ACTION_TIMEOUT=10

# Memory Configuration
MEMORY_ENABLED=true
MEMORY_MAX_CONTEXT=10
MEMORY_MIN_IMPORTANCE=0.6

# Data Paths
RUOX_DB_PATH=data/memory.db
RUOX_LOG_PATH=logs/audit.log
